# Database
# Local Postgres, or a cloud connection string (Neon, Render, Supabase).
# Leave unset to fall back to a local SQLite file — fine for a quick look,
# not for anything you want to keep.
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/stylesense

# Only used by create_db.py to bootstrap a LOCAL database. Not needed in production.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# JWT Authentication
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-this-to-a-random-secret-key
JWT_ACCESS_TOKEN_EXPIRES=86400

# Upload settings (images are processed in memory, never written to disk)
MAX_CONTENT_LENGTH=10485760

# CORS (comma-separated origins for production)
CORS_ORIGINS=http://localhost:5173

# Flask
FLASK_ENV=development
FLASK_DEBUG=1
